# Chip mặc định của nhóm
CONFIG_IDF_TARGET="esp32s3"

# Bật thu CSI (mặc định tắt)
CONFIG_ESP_WIFI_CSI_ENABLED=y

# Như sdkconfig.defaults của csi_recv / csi_recv_router (esp-csi):
# tắt AMPDU để mỗi gói có một khung CSI, tăng bộ đệm nhận cho 100 gói/giây
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=128

# Nhịp 1 ms để ping 10 ms một lần chạy đều
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
